# ---------------------------------------------------------------- 运行态数据
# scan-cache.json 的键是**本机绝对路径**，日志首行会打出数据目录 —— 都会泄露
# 用户名与目录结构，绝不能入库。
scan-cache.json
server.log
server.prev.log
stdout.log
stderr.log
deploy.log
*.log

# 发布脚本（release_frontend.py）写在这里的临时提交信息文件，用完即删，不该入库
_release_msg.txt

# ---------------------------------------------------------------- 打包产物
dist/
build/
_build/
*.spec
*.manifest

# ---------------------------------------------------------------- 本地部署目录
# 有时会把 exe 拷到一个固定目录再交给进程管理器托管，这类目录不入库
service/
*.exe
*.exe.old

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
