# 仓库内统一存 LF，检出时按类型转换
* text=auto

# 脚本按目标平台固定行尾：POSIX 脚本必须 LF，否则 Linux/macOS 报 bad interpreter
*.sh    text eol=lf
*.py    text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf

# Windows 脚本保持 CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.exe   binary
*.dll   binary
*.png   binary
*.jpg   binary
*.ico   binary
